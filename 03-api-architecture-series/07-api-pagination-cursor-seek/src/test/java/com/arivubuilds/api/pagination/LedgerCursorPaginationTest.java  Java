package com.arivubuilds.api.pagination;

import com.arivubuilds.api.pagination.entity.LedgerEntry;
import com.arivubuilds.api.pagination.repository.LedgerRepository;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc;
import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.http.MediaType;
import org.springframework.test.web.servlet.MockMvc;

import java.math.BigDecimal;
import java.time.Instant;
import java.util.List;

import static org.hamcrest.Matchers.hasSize;
import static org.hamcrest.Matchers.notNullValue;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;

@SpringBootTest
@AutoConfigureMockMvc
class LedgerCursorPaginationTest {

    @Autowired
    private MockMvc mockMvc;

    @Autowired
    private LedgerRepository ledgerRepository;

    @BeforeEach
    void setupTestData() {
        ledgerRepository.deleteAll();

        Instant baseTime = Instant.parse("2026-11-10T12:00:00Z");

        // Seed 5 records with identical timestamp on items 2 & 3 to test tie-breakers
        List<LedgerEntry> seeds = List.of(
                new LedgerEntry("txn_001", "acc_1", new BigDecimal("100.00"), baseTime.plusSeconds(50)),
                new LedgerEntry("txn_002", "acc_1", new BigDecimal("200.00"), baseTime.plusSeconds(40)),
                new LedgerEntry("txn_003", "acc_2", new BigDecimal("300.00"), baseTime.plusSeconds(40)), // Same timestamp
                new LedgerEntry("txn_004", "acc_1", new BigDecimal("400.00"), baseTime.plusSeconds(20)),
                new LedgerEntry("txn_005", "acc_3", new BigDecimal("500.00"), baseTime.plusSeconds(10))
        );
        ledgerRepository.saveAll(seeds);
    }

    @Test
    @DisplayName("First Page: Retrieves page of requested size with nextCursor and hasNextPage=true")
    void testFirstPageCursor() throws Exception {
        mockMvc.perform(get("/api/v1/ledger?limit=2")
                        .contentType(MediaType.APPLICATION_JSON))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.data", hasSize(2)))
                .andExpect(jsonPath("$.data[0].id").value("txn_001"))
                .andExpect(jsonPath("$.data[1].id").value("txn_003")) // txn_003 precedes txn_002 lexicographically
                .andExpect(jsonPath("$.pagination.hasNextPage").value(true))
                .andExpect(jsonPath("$.pagination.nextCursor", notNullValue()));
    }

    @Test
    @DisplayName("Seek Next Page: Traverses contiguous records using opaque cursor across tie-breakers")
    void testCursorSeekAcrossTieBreakers() throws Exception {
        // 1. Fetch first page of 2 items
        String response = mockMvc.perform(get("/api/v1/ledger?limit=2"))
                .andExpect(status().isOk())
                .andReturn().getResponse().getContentAsString();

        // Extract nextCursor
        String nextCursor = com.jayway.jsonpath.JsonPath.read(response, "$.pagination.nextCursor");

        // 2. Fetch second page using cursor
        mockMvc.perform(get("/api/v1/ledger?limit=2&cursor=" + nextCursor))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.data", hasSize(2)))
                .andExpect(jsonPath("$.data[0].id").value("txn_002")) // Tie-breaker resolves accurately
                .andExpect(jsonPath("$.data[1].id").value("txn_004"))
                .andExpect(jsonPath("$.pagination.hasNextPage").value(true));
    }

    @Test
    @DisplayName("Last Page: Exhausts dataset without skipping, setting hasNextPage=false")
    void testExhaustingDataset() throws Exception {
        mockMvc.perform(get("/api/v1/ledger?limit=10"))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.data", hasSize(5)))
                .andExpect(jsonPath("$.pagination.hasNextPage").value(false))
                .andExpect(jsonPath("$.pagination.nextCursor").doesNotExist());
    }
}